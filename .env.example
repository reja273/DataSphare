PORT=3000
NODE_ENV=development
JWT_SECRET=
# Generate a secret with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
# Local development may omit MONGODB_URI and use backend/data.json. Hosted production must use MongoDB.
MONGODB_URI=
USE_JSON_STORE=0
# Set USE_JSON_STORE=1 to force the local JSON adapter for an isolated smoke run.
# Set to 1 only when deployed behind a trusted reverse proxy.
TRUST_PROXY=0
# Optional comma-separated frontend origins if the frontend is hosted separately.
CORS_ORIGIN=
